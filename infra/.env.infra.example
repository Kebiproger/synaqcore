# ==============================================================================
# POSTGRES-APP — бизнес-БД synaq (эксперименты). Контейнер postgres-app.
# Те же USER/PASSWORD/DB укажите в apps/.env.apps.
# ==============================================================================
POSTGRES_HOST=postgres-app
POSTGRES_PORT=5432
POSTGRES_USER=synaq
POSTGRES_PASSWORD=change_me_app_db_password
POSTGRES_DB=synaqcore

# Прикладные роли postgres-app (создаёт одноразовый postgres-app-init при каждом `up`):
#   synaq_app       — владелец схем public/events; этот же пароль — в apps/.env.apps;
#   synaq_analytics — только чтение событий (analytics_api).
# Не короче 16 символов и разные; иначе postgres-app-init завершится с ошибкой.
# Сгенерируйте:  tr -dc A-Za-z0-9 </dev/urandom | head -c 32
SYNAQ_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=

# Хранилище событий: postgres (по умолчанию, схема events в postgres-app) или
# clickhouse (нужен профиль scale: docker compose --profile scale up -d).
# EVENT_STORE=postgres

# ==============================================================================
# CLICKHOUSE — только профиль scale (EVENT_STORE=clickhouse); тогда пароль обязателен
# ==============================================================================
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me_clickhouse_password
CLICKHOUSE_DB=synaqcore

# ==============================================================================
# ZITADEL (IdP). У Zitadel СОБСТВЕННЫЙ Postgres — контейнер postgres-zitadel
# (том postgres_zitadel_data), отдельный от бизнес-БД postgres-app.
# ADMIN_USERNAME/_PASSWORD — суперпользователь postgres-zitadel (POSTGRES_USER/
# POSTGRES_PASSWORD этого контейнера); нужен только одноразовому zitadel-dbinit.
# USER_PASSWORD — пароль непривилегированного пользователя `zitadel`.
# ==============================================================================
# Ровно 32 символа; менять после первой инициализации нельзя. Сгенерируйте свой:
#   tr -dc A-Za-z0-9 </dev/urandom | head -c 32
# `make up` откажется стартовать с пустым/образцовым ключом или ключом не из 32 символов.
ZITADEL_MASTERKEY=
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=change_me_zitadel_db_password
ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME=postgres
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=change_me_zitadel_db_admin_password
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=zitadel-admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=Change_me_Zitadel_Admin_1!
# Срок bootstrap-PAT (≈ now+30d): date -u -d '+30 days' +%Y-%m-%dT00:00:00Z
ZITADEL_BOOTSTRAP_PAT_EXPIRATION=2026-11-20T00:00:00Z
