# ==============================================================================
# SYNAQ (Go-монолит: выдача вариантов, admin API, трекер) — lite-стек
# ==============================================================================
# Секретов здесь нет. Пароли БД (SYNAQ_DB_PASSWORD, ANALYTICS_DB_PASSWORD),
# POSTGRES_DB и CLICKHOUSE_PASSWORD берутся из infra/.env.infra: корневой
# docker-compose.yml интерполирует ими apps-compose. Подключение к БД задаёт
# compose (роли synaq_app / synaq_analytics); POSTGRES_USER/POSTGRES_PASSWORD
# здесь не нужны, а устаревшие значения из старого .env.apps игнорируются.
#
# Хранилище событий выбирает EVENT_STORE в infra/.env.infra или в shell:
# postgres (по умолчанию) или clickhouse (`make up-scale`).
#
# Всё ниже необязательно: значения по умолчанию заданы в коде.

# Пул записи событий в Postgres (режим EVENT_STORE=postgres)
# PG_EVENTS_MAX_CONNS=2

# Буфер и батчи записи в ClickHouse (только EVENT_STORE=clickhouse)
CH_BUFFER_SIZE=10000
CH_MAX_BUFFERED_BYTES=67108864
CH_BATCH_SIZE=1000
CH_FLUSH_INTERVAL=1s
