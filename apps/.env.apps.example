# ==============================================================================
# SYNAQ (Go-монолит: выдача вариантов, admin API, трекер) — lite-стек
# ==============================================================================
PORT=8000

# События пишутся напрямую в ClickHouse (Kafka/Redpanda в lite нет).
# docker-compose задаёт EVENT_SINK и CLICKHOUSE_URL сам; здесь — для локального запуска.
EVENT_SINK=clickhouse
CLICKHOUSE_URL=http://clickhouse:8123
# Буфер и батчи записи в ClickHouse (значения по умолчанию)
CH_BUFFER_SIZE=10000
CH_MAX_BUFFERED_BYTES=67108864
CH_BATCH_SIZE=1000
CH_FLUSH_INTERVAL=1s

# Бизнес-БД synaq — отдельный контейнер postgres-app (POSTGRES_HOST задаёт compose).
# USER/PASSWORD/DB должны совпадать с POSTGRES_* в infra/.env.infra.
POSTGRES_HOST=postgres-app
POSTGRES_PORT=5432
POSTGRES_USER=synaq
POSTGRES_PASSWORD=change_me_app_db_password
POSTGRES_DB=synaqcore

# ==============================================================================
# CLICKHOUSE (synaq пишет события, analytics_api читает)
# Должны совпадать с CLICKHOUSE_USER/CLICKHOUSE_PASSWORD в infra/.env.infra.
# ==============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me_clickhouse_password
